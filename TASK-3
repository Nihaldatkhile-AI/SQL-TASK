-- ---------- A. Simple SELECT / WHERE ----------
SELECT * FROM Customers;
SELECT Customer_Name, Email, City FROM Customers;
SELECT Customer_Name, Age, Account_Balance FROM Customers;
SELECT * FROM Customers WHERE City = 'Pune';
SELECT * FROM Customers WHERE Gender = 'F';
SELECT * FROM Customers WHERE Age > 35;
SELECT * FROM Customers WHERE Account_Balance > 80000;
SELECT * FROM Customers WHERE Customer_ID = 25;
SELECT * FROM Customers WHERE Registration_Date = '2025-05-10';
SELECT * FROM Customers WHERE City <> 'Mumbai';


-- ---------- B. Comparison Operators ----------
SELECT Customer_Name, Age FROM Customers WHERE Age > 40;
SELECT Customer_Name, Age FROM Customers WHERE Age < 26;
SELECT Customer_Name, Age FROM Customers WHERE Age >= 30;
SELECT Customer_Name, Age FROM Customers WHERE Age <= 28;
SELECT Customer_Name, Account_Balance FROM Customers WHERE Account_Balance >= 100000;
SELECT Customer_Name, Account_Balance FROM Customers WHERE Account_Balance < 35000;
SELECT * FROM Customers WHERE Gender <> 'M';
SELECT * FROM Customers WHERE Registration_Date > '2025-07-01';


-- ---------- C. AND ----------
SELECT * FROM Customers WHERE City = 'Delhi' AND Gender = 'M';
SELECT * FROM Customers WHERE Age < 30 AND Account_Balance > 45000;
SELECT * FROM Customers WHERE City = 'Hyderabad' AND Age >= 29;
SELECT * FROM Customers WHERE Gender = 'F' AND Account_Balance BETWEEN 40000 AND 60000;


-- ---------- D. OR ----------
SELECT * FROM Customers WHERE City = 'Kolkata' OR City = 'Patna';
SELECT * FROM Customers WHERE Age < 24 OR Age > 42;
SELECT * FROM Customers WHERE Account_Balance < 32000 OR Account_Balance > 110000;
SELECT * FROM Customers WHERE City = 'Indore' OR City = 'Bhopal' OR City = 'Nashik';


-- ---------- E. NOT ----------
SELECT * FROM Customers WHERE NOT City = 'Pune';
SELECT * FROM Customers WHERE NOT Gender = 'M';
SELECT * FROM Customers WHERE NOT Age = 28;
SELECT * FROM Customers WHERE City NOT IN ('Mumbai', 'Delhi', 'Pune');


-- ---------- F. BETWEEN ----------
SELECT * FROM Customers WHERE Age BETWEEN 30 AND 40;
SELECT * FROM Customers WHERE Account_Balance BETWEEN 50000 AND 90000;
SELECT * FROM Customers WHERE Registration_Date BETWEEN '2025-01-01' AND '2025-03-31';
SELECT * FROM Customers WHERE Age NOT BETWEEN 26 AND 34;


-- ---------- G. LIKE ----------
SELECT * FROM Customers WHERE Customer_Name LIKE 'S%';
SELECT * FROM Customers WHERE Customer_Name LIKE '%Sharma';
SELECT * FROM Customers WHERE Customer_Name LIKE '%Kap%';
SELECT * FROM Customers WHERE Customer_Name LIKE '%ya%';
SELECT * FROM Customers WHERE City LIKE 'B%';
SELECT * FROM Customers WHERE City LIKE '%pur';
SELECT * FROM Customers WHERE Customer_Name LIKE 'R____ %';
SELECT * FROM Customers WHERE Phone LIKE '98765432_5';
SELECT * FROM Customers WHERE Email LIKE 'a%';
SELECT * FROM Customers WHERE Customer_Name NOT LIKE 'A%';


-- ---------- H. IS NULL / IS NOT NULL ----------
SELECT * FROM Customers WHERE City IS NULL;
SELECT * FROM Customers WHERE Email IS NULL;
SELECT * FROM Customers WHERE Phone IS NOT NULL;
SELECT * FROM Customers WHERE Registration_Date IS NOT NULL;


-- ---------- I. DISTINCT ----------
SELECT DISTINCT City FROM Customers;
SELECT DISTINCT Gender FROM Customers;
SELECT DISTINCT Age FROM Customers;
SELECT DISTINCT City, Gender FROM Customers;
SELECT COUNT(DISTINCT City) AS Total_Cities FROM Customers;


-- ---------- J. Aggregate Functions ----------
SELECT COUNT(*) AS Total_Customers FROM Customers;
SELECT SUM(Account_Balance)  AS Total_Deposit   FROM Customers;
SELECT AVG(Account_Balance)  AS Average_Balance FROM Customers;
SELECT MAX(Account_Balance)  AS Highest_Balance FROM Customers;
SELECT MIN(Account_Balance)  AS Lowest_Balance  FROM Customers;
SELECT MAX(Age) AS Oldest, MIN(Age) AS Youngest FROM Customers;
SELECT COUNT(*) AS Male_Count   FROM Customers WHERE Gender = 'M';
SELECT COUNT(*) AS Female_Count FROM Customers WHERE Gender = 'F';


-- ---------- K. GROUP BY ----------
SELECT City, COUNT(*) AS Customers_Count FROM Customers GROUP BY City;
SELECT City, SUM(Account_Balance) AS City_Total   FROM Customers GROUP BY City;
SELECT City, AVG(Account_Balance) AS City_Average FROM Customers GROUP BY City;
SELECT City, MAX(Account_Balance) AS Top_Balance  FROM Customers GROUP BY City;
SELECT Gender, COUNT(*) AS Total FROM Customers GROUP BY Gender;
SELECT Gender, AVG(Age) AS Average_Age FROM Customers GROUP BY Gender;
SELECT Gender, MIN(Account_Balance) AS Lowest FROM Customers GROUP BY Gender;
SELECT City, Gender, COUNT(*) AS Total FROM Customers GROUP BY City, Gender;


-- ---------- L. GROUP BY + HAVING ----------
SELECT City, COUNT(*) AS Total FROM Customers
GROUP BY City HAVING COUNT(*) >= 3;

SELECT City, SUM(Account_Balance) AS City_Total FROM Customers
GROUP BY City HAVING SUM(Account_Balance) > 150000;

SELECT City, AVG(Account_Balance) AS City_Average FROM Customers
GROUP BY City HAVING AVG(Account_Balance) >= 70000;

SELECT Gender, AVG(Age) AS Average_Age FROM Customers
GROUP BY Gender HAVING AVG(Age) > 30;

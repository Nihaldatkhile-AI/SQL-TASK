USE sample;

SELECT * FROM `demart data`;


-- Create a new column named Month_Name and store the month name extract from order_date.
ALTER TABLE `demart data` ADD COLUMN Month_Name VARCHAR(15);
UPDATE `demart data`
SET Month_Name = MONTHNAME(STR_TO_DATE(order_date, '%d-%m-%Y'));


-- Create a new column named Discount_Amount and calculate a 10% discount on the Sales amount.
ALTER TABLE `demart data` ADD COLUMN Discount_Amount DECIMAL(10,2);
UPDATE `demart data`
SET Discount_Amount = sales * 0.10;


-- Create a new column named Net_Revenue and calculate Net Revenue after applying a 10% discount on Sales.
ALTER TABLE `demart data` ADD COLUMN Net_Revenue DECIMAL(10,2);
UPDATE `demart data`
SET Net_Revenue = sales - Discount_Amount;


-- Display all records from the Orders table.
SELECT * FROM `demart data`;


-- Display only order_id, category, sales, and profit.
SELECT order_id, category, sales, profit
FROM `demart data`;


-- Display all unique regions.
SELECT DISTINCT region FROM `demart data`;


-- Display all unique categories.
SELECT DISTINCT category FROM `demart data`;


-- Display all unique payment modes.
SELECT DISTINCT payment_mode FROM `demart data`;


-- Display all unique customer types.
SELECT DISTINCT customer_type FROM `demart data`;


-- Display order_id, sales, and profit with appropriate aliases.
SELECT order_id AS Order_Number,
       sales    AS Sales_Amount,
       profit   AS Profit_Earned
FROM `demart data`;


-- Display orders where the region is East.
SELECT * FROM `demart data`
WHERE region = 'East';


-- Display orders where the category is Electronics.
SELECT * FROM `demart data`
WHERE category = 'Electronics';


-- Display orders where sales are greater than 3000.
SELECT * FROM `demart data`
WHERE sales > 3000;


-- Display orders where profit is greater than 500.
SELECT * FROM `demart data`
WHERE profit > 500;


-- Display orders where quantity is greater than 5.
SELECT * FROM `demart data`
WHERE quantity > 5;


-- Display orders where discount is greater than 20%.
SELECT * FROM `demart data`
WHERE discount > 0.20;


-- Display orders where payment mode is UPI.
SELECT * FROM `demart data`
WHERE payment_mode = 'UPI';


-- Display orders where customer type is Member.
SELECT * FROM `demart data`
WHERE customer_type = 'Member';


-- Display orders from the East region where sales are greater than 2000.
SELECT * FROM `demart data`
WHERE region = 'East' AND sales > 2000;


-- Display orders where category is Clothing OR Grocery.
SELECT * FROM `demart data`
WHERE category = 'Clothing' OR category = 'Grocery';


-- Display orders where payment mode is UPI AND customer type is Member.
SELECT * FROM `demart data`
WHERE payment_mode = 'UPI' AND customer_type = 'Member';


-- Display orders where sales are greater than 3000 AND profit is greater than 500.
SELECT * FROM `demart data`
WHERE sales > 3000 AND profit > 500;


-- Display orders that are NOT from the East region.
SELECT * FROM `demart data`
WHERE NOT region = 'East';


-- Display orders where sales are between 1000 and 3000.
SELECT * FROM `demart data`
WHERE sales BETWEEN 1000 AND 3000;


-- Display orders where quantity is between 3 and 6.
SELECT * FROM `demart data`
WHERE quantity BETWEEN 3 AND 6;


-- Display orders from East, West, and North regions.
SELECT * FROM `demart data`
WHERE region IN ('East', 'West', 'North');


-- Find customers whose city starts with M.
SELECT * FROM `demart data`
WHERE city LIKE 'M%';


-- Find cities ending with i.
SELECT DISTINCT city FROM `demart data`
WHERE city LIKE '%i';


-- Display all orders sorted by sales from highest to lowest.
SELECT * FROM `demart data`
ORDER BY sales DESC;


-- Display all orders sorted by profit from lowest to highest.
SELECT * FROM `demart data`
ORDER BY profit ASC;


-- Display orders first by region and then by sales in descending order.
SELECT * FROM `demart data`
ORDER BY region ASC, sales DESC;


-- Display the top 5 orders based on sales.
SELECT * FROM `demart data`
ORDER BY sales DESC
LIMIT 5;


-- Find the total profit.
SELECT SUM(profit) AS Total_Profit
FROM `demart data`;


-- Find the total quantity sold.
SELECT SUM(quantity) AS Total_Quantity
FROM `demart data`;


-- Find the average sales amount.
SELECT AVG(sales) AS Average_Sales
FROM `demart data`;


-- Find the maximum sales amount.
SELECT MAX(sales) AS Maximum_Sales
FROM `demart data`;


-- Find the minimum sales amount.
SELECT MIN(sales) AS Minimum_Sales
FROM `demart data`;


-- Count the total number of orders.
SELECT COUNT(*) AS Total_Orders
FROM `demart data`;


-- Find total sales by region.
SELECT region, SUM(sales) AS Total_Sales
FROM `demart data`
GROUP BY region;


-- Find total profit by region.
SELECT region, SUM(profit) AS Total_Profit
FROM `demart data`
GROUP BY region;


-- Find total sales by category.
SELECT category, SUM(sales) AS Total_Sales
FROM `demart data`
GROUP BY category;


-- Find total quantity sold by category.
SELECT category, SUM(quantity) AS Total_Quantity
FROM `demart data`
GROUP BY category;


-- Find number of orders by customer type.
SELECT customer_type, COUNT(*) AS Total_Orders
FROM `demart data`
GROUP BY customer_type;


-- Find total sales by payment mode.
SELECT payment_mode, SUM(sales) AS Total_Sales
FROM `demart data`
GROUP BY payment_mode;


-- Find total profit by city.
SELECT city, SUM(profit) AS Total_Profit
FROM `demart data`
GROUP BY city;


-- Find average discount by category.
SELECT category, AVG(discount) AS Average_Discount
FROM `demart data`
GROUP BY category;


-- Display total sales by month.
SELECT Month_Name, SUM(sales) AS Total_Sales
FROM `demart data`
GROUP BY Month_Name
ORDER BY MONTH(STR_TO_DATE(CONCAT('01-', Month_Name, '-2000'), '%d-%M-%Y'));


-- Display customer types having more than 3 orders.
SELECT customer_type, COUNT(*) AS Total_Orders
FROM `demart data`
GROUP BY customer_type
HAVING COUNT(*) > 3;


-- Categorize orders based on sales:
-- Sales >= 4000 -> High
-- Sales >= 2000 -> Medium
-- Otherwise -> Low
SELECT order_id, sales,
       CASE
           WHEN sales >= 4000 THEN 'High'
           WHEN sales >= 2000 THEN 'Medium'
           ELSE 'Low'
       END AS Sales_Category
FROM `demart data`;


-- Categorize profit:
-- Profit >= 800 -> High Profit
-- Profit >= 400 -> Medium Profit
-- Otherwise -> Low Profit
SELECT order_id, profit,
       CASE
           WHEN profit >= 800 THEN 'High Profit'
           WHEN profit >= 400 THEN 'Medium Profit'
           ELSE 'Low Profit'
       END AS Profit_Category
FROM `demart data`;


-- Categorize discount:
-- Discount >= 30% -> High Discount
-- Discount >= 15% -> Medium Discount
-- Otherwise -> Low Discount
SELECT order_id, discount,
       CASE
           WHEN discount >= 0.30 THEN 'High Discount'
           WHEN discount >= 0.15 THEN 'Medium Discount'
           ELSE 'Low Discount'
       END AS Discount_Category
FROM `demart data`;


-- Categorize customers:
-- Member -> Premium Customer
-- Regular -> Regular Customer
-- New -> New Customer
SELECT order_id, customer_type,
       CASE customer_type
           WHEN 'Member'  THEN 'Premium Customer'
           WHEN 'Regular' THEN 'Regular Customer'
           WHEN 'New'     THEN 'New Customer'
       END AS Customer_Category
FROM `demart data`;


-- Categorize orders based on quantity:
-- Quantity >= 6 -> Bulk Order
-- Quantity >= 3 -> Medium Order
-- Otherwise -> Small Order
SELECT order_id, quantity,
       CASE
           WHEN quantity >= 6 THEN 'Bulk Order'
           WHEN quantity >= 3 THEN 'Medium Order'
           ELSE 'Small Order'
       END AS Quantity_Category
FROM `demart data`;

-- ---------- 5. Collections : 200 transaction records ----------
CREATE TABLE collections (
    collection_id      INT PRIMARY KEY,
    donor_id           INT NOT NULL,
    center_id          INT NOT NULL,
    category_id        INT NOT NULL,
    partner_id         INT NOT NULL,
    collection_date    DATE NOT NULL,
    channel            ENUM('Walk In','Doorstep Pickup','Bulk Drive','Corporate Tie Up') NOT NULL,
    quantity_units     INT NOT NULL CHECK (quantity_units > 0),
    weight_kg          DECIMAL(8,2)  NOT NULL,
    condition_grade    CHAR(1)       NOT NULL,
    recovered_value_inr DECIMAL(10,2) NOT NULL,
    co2_saved_kg       DECIMAL(8,2)  NOT NULL,
    status             ENUM('Collected','In Transit','Dismantled','Recycled','Refurbished') NOT NULL,
    CONSTRAINT fk_col_donor   FOREIGN KEY (donor_id)    REFERENCES donors(donor_id),
    CONSTRAINT fk_col_center  FOREIGN KEY (center_id)   REFERENCES collection_centers(center_id),
    CONSTRAINT fk_col_cat     FOREIGN KEY (category_id) REFERENCES device_categories(category_id),
    CONSTRAINT fk_col_partner FOREIGN KEY (partner_id)  REFERENCES recycling_partners(partner_id)
);


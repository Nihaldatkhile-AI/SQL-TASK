-- ---------- Indexes ----------
CREATE INDEX idx_col_date     ON collections(collection_date);
CREATE INDEX idx_col_status   ON collections(status);
CREATE INDEX idx_col_center   ON collections(center_id);
CREATE INDEX idx_col_category ON collections(category_id);

-- ---------- Reusable view ----------
CREATE VIEW v_collection_full AS
SELECT c.collection_id,
       c.collection_date,
       d.donor_name,
       d.donor_type,
       cc.center_name,
       cc.city             AS center_city,
       dc.category_name,
       dc.hazard_level,
       rp.partner_name,
       c.channel,
       c.quantity_units,
       c.weight_kg,
       c.condition_grade,
       c.recovered_value_inr,
       c.co2_saved_kg,
       c.status
FROM collections c
JOIN donors             d  ON d.donor_id    = c.donor_id
JOIN collection_centers cc ON cc.center_id  = c.center_id
JOIN device_categories  dc ON dc.category_id= c.category_id
JOIN recycling_partners rp ON rp.partner_id = c.partner_id;

SELECT COUNT(*) AS total_records FROM collections;  -- expect 200
